{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignore": [
      "dist",
      "node_modules",
      // mind now has TS source under src/ (lint it) + test/ alongside the Python
      // toolkit and the markdown corpus. Narrowed from a blanket packages/mind/**
      // ignore when the corpus inverted to TS modules (T1.1/T1.3); the non-TS
      // trees (Python toolkit, markdown cells, graphify cache, pipeline manifests)
      // stay ignored.
      "packages/mind/toolkit/**",
      "packages/mind/references/**",
      "packages/mind/docs/**",
      "packages/mind/ideas/**",
      "packages/mind/.manifests/**",
      "packages/mind/**/*.md",
      "**/*.generated.ts",
      "**/generated.ts",
      // emit_ir.py output (a generated IR artifact, not hand-authored source)
      "**/ir-bridge/mind.koine.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "overrides": [
    {
      "include": ["**/test/**", "**/*.test.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      // Generated mind fragment / skill modules: their definiens / verbatim body
      // are emitted as backtick template literals UNIFORMLY (codegen policy —
      // handles multi-line + any embedded quote without per-string analysis), so
      // the "unused template literal" style rule does not apply to them.
      "include": ["packages/mind/src/organs/**", "packages/mind/src/skills/**"],
      "linter": { "rules": { "style": { "noUnusedTemplateLiteral": "off" } } }
    }
  ]
}
