{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignore": [
      "dist",
      "node_modules",
      // canon now has TS source under src/ (lint it) + test/ alongside the Python
      // toolkit and the markdown corpus. Narrowed from a blanket packages/canon/**
      // ignore when the corpus inverted to TS modules (T1.1/T1.3); the non-TS
      // trees (Python toolkit, markdown cells, graphify cache, pipeline manifests)
      // stay ignored.
      "packages/canon/toolkit/**",
      "packages/canon/references/**",
      "packages/canon/docs/**",
      "packages/canon/ideas/**",
      // graphify's tool-emitted cache/graph output (specimens, not source) —
      // `**/`-anchored because turbo runs biome from the package cwd, where the
      // repo-root-anchored `packages/canon/ideas/**` glob does not match.
      "**/graphify-out/**",
      "packages/canon/.manifests/**",
      "packages/canon/**/*.md",
      "**/*.generated.ts",
      "**/generated.ts",
      // emit_ir.py output (a generated IR artifact, not hand-authored source)
      "**/ir-bridge/canon.forge.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "overrides": [
    {
      // tsc reads every `tsconfig*.json` as JSONC. Biome special-cases the bare
      // `tsconfig.json` name only, so the sibling configs (`.build`, `.test`)
      // need the parser told explicitly — otherwise a comment in one is a
      // "End of file expected" parse error and biome refuses to format the file.
      "include": ["**/tsconfig.*.json"],
      "json": { "parser": { "allowComments": true } }
    },
    {
      "include": ["**/test/**", "**/*.test.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      // Generated canon fragment / skill modules: their definiens / verbatim body
      // are emitted as backtick template literals UNIFORMLY (codegen policy —
      // handles multi-line + any embedded quote without per-string analysis), so
      // the "unused template literal" style rule does not apply to them.
      "include": [
        "packages/canon/src/dimensions/**",
        "packages/canon/src/skills/**"
      ],
      "linter": { "rules": { "style": { "noUnusedTemplateLiteral": "off" } } }
    }
  ]
}
