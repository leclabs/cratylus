{
  "schema": 1,
  "reader": "strong-llm-lean",
  "fleet": {
    "hosts": ["localhost", "build-01", "gpu-01"],
    "exclude": []
  },
  "host": {
    "localhost": { "local": true },
    "build-01": { "user": "YOUR_SSH_USER" },
    "gpu-01": { "user": "YOUR_SSH_USER", "hostname": "gpu-01.example.internal", "home": "~/.claude" }
  }
}
