{
  "worktree": {
    "bgIsolation": "worktree",
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lex/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lex/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cratylus-run carryOn terminus --plan-root 'plans/' --states 'pending,ready,active,completed' --completed 'completed' --frontier 'ready,active' --bound-marker '.bound' --ruling-owed-marker '.ruling-owed'",
            "id": "cratylus-run-carry-on"
          }
        ]
      }
    ]
  }
}
