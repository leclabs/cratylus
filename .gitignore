node_modules/
dist/
.turbo/
*.tsbuildinfo
.compile-state.json
.DS_Store
*.log
.env
.env.local
# direnv's shell file. It carries live credentials BY DESIGN — that is what direnv is for — so it
# is per-machine operator state, never repo state. Without this rule a `git add -A` sweeps it into
# a commit, which is exactly how it once reached history and had to be scrubbed back out.
.envrc
.forge/local/
.claude/worktrees/
# A project installation, one subdirectory per harness (`cratylus install --scope project`),
# or an earlier render tree. Ignored here: this repository develops cratylus and commits no
# installation of it.
.cratylus/
__pycache__/
*.pyc
.scratchpad/
# Agent memory stores are per-agent home state — never repo-tracked (raw EPISODIC capture is agent-home only).
EPISODIC.jsonl
MEMORY.md
SELF.md

# Release staging: tarballs packed for upload. Regenerated every run.
.pack/

# PACKED TARBALLS, wherever they land. `.pack/` is the release script's staging dir and
# was already ignored — but `pnpm pack` without `--pack-destination` writes into the
# PACKAGE dir, and one such tarball sat untracked-and-committable in `packages/cli/`
# after a manual publish. A build artifact that only some invocations put in the
# ignored place is a build artifact one `git add -A` from being committed.
*.tgz
