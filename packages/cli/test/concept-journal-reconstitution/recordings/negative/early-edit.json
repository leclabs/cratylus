{
  "name": "Edit tool before readback",
  "target": "never-act-before-readback",
  "events": [
    {
      "kind": "tool",
      "name": "bash",
      "arguments": {
        "command": "pnpm cratylus concepts state"
      }
    },
    {
      "kind": "tool",
      "name": "edit",
      "arguments": {
        "path": "next-step.txt",
        "edits": [
          {
            "op": "replace",
            "pos": "1#AB",
            "lines": ["Plan payment."]
          }
        ]
      }
    },
    {
      "kind": "text",
      "text": "The compaction summary is out of date. Reservations expire after fifteen minutes. The deposit decision is accepted. The reminder decision remains open."
    }
  ]
}
