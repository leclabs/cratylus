{
  "name": "cratylus",
  "version": "0.21.0",
  "description": "cratylus installs a team of AI agents in industry roles, with its rules, skills and capabilities, into the agent harness you already use. The team holds your meaning in a living domain model written by Cratylic context design, and realizes it by behaviour-driven development.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "cratylus": "./dist/cratylus.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@cratylus/canon": "workspace:*",
    "@cratylus/forge": "workspace:*",
    "@cratylus/runtime": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "js-yaml": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cratylic-context-design",
    "cratylus",
    "runtime",
    "cli",
    "agent",
    "capability"
  ],
  "author": "Lance Caraccioli <lance.caraccioli@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leclabs/cratylus.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/leclabs/cratylus/issues"
  },
  "homepage": "https://github.com/leclabs/cratylus#readme",
  "exports": {
    "./package.json": "./package.json"
  }
}
