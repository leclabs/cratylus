{
  "name": "cratylus",
  "version": "0.2.1",
  "description": "The cratylus command line: project a corpus of agent semantics onto any harness, and the runtime the projected artifacts call back into.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "cratylus": "./dist/cratylus.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@cratylus/canon": "workspace:*",
    "@cratylus/forge": "workspace:*",
    "@cratylus/memory": "workspace:*",
    "@cratylus/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "latent-lexicography",
    "cratylus",
    "runtime",
    "cli",
    "agent",
    "capability"
  ],
  "author": "Lance Caraccioli <lance.caraccioli@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leclabs/cratylus.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/leclabs/cratylus/issues"
  },
  "homepage": "https://github.com/leclabs/cratylus#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
