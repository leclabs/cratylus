{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leclabs.dev/agent-forge/v1/agent.schema.json",
  "title": "Agent",
  "description": "A subagent definition. System prompt body plus frontmatter declaring tools, model, color.",
  "type": "object",
  "required": ["name", "body"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "body": {
      "type": "string",
      "description": "System prompt for the subagent."
    },
    "description": { "type": "string" },
    "model": { "type": "string" },
    "tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "color": { "type": "string" },
    "permission_mode": {
      "type": "string",
      "description": "Permission stance the agent runs under (Claude permissionMode: default/plan/acceptEdits/…). Adapter-mapped or warned."
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "description": "Turn budget for a run (Claude maxTurns, Gemini max_turns)."
    },
    "temperature": {
      "type": "number",
      "description": "Sampling temperature (Gemini/opencode/Kilo)."
    },
    "mode": {
      "enum": ["primary", "subagent", "all"],
      "description": "Invocation surface the agent is offered on (Kilo/opencode mode)."
    },
    "memory": {
      "type": "string",
      "description": "Persistent-memory scope (Claude memory: user/project/local)."
    },
    "effort": {
      "type": "string",
      "description": "Reasoning-effort hint (Claude effort)."
    },
    "targets": { "type": "array", "items": { "type": "string" } },
    "excludes": { "type": "array", "items": { "type": "string" } }
  }
}
