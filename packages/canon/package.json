{
  "name": "@cratylus/canon",
  "version": "0.0.0",
  "description": "The canonical corpus of discovered optimal-signifiers — agents, skills, dimensions and rules as typed TS source. Markdown is a projection of these modules.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "pnpm run build && vitest run",
    "project:targets": "tsx tooling/project-targets-cli.ts",
    "plan-set": "tsx tooling/plan-set-cli.ts",
    "scaffold": "tsx tooling/scaffold-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "pnpm run build",
    "pack:smoke": "tsx tooling/pack-smoke/pack-smoke-cli.ts"
  },
  "//test": "`test` builds FIRST because `test/runtime-shim.test.ts` drives the shipped `cratylus project` over the repository's own `agents.config.ts`, and that config extends `@cratylus/canon` — the PACKAGE, i.e. this package's `dist`. turbo's `test.dependsOn: [^build]` builds this package's DEPENDENCIES, never this package, so a cold clone would run the consumer path against a dist that does not exist.",
  "dependencies": {
    "@cratylus/forge": "workspace:*",
    "@cratylus/runtime": "workspace:*",
    "@cratylus/schema": "workspace:*"
  },
  "devDependencies": {
    "@repo/tooling": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "latent-lexicography",
    "cratylus",
    "canon",
    "agent",
    "skill",
    "prompt",
    "llm",
    "semantic-address"
  ],
  "author": "Lance Caraccioli <lance.caraccioli@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leclabs/cratylus.git",
    "directory": "packages/canon"
  },
  "bugs": {
    "url": "https://github.com/leclabs/cratylus/issues"
  },
  "homepage": "https://github.com/leclabs/cratylus#readme"
}
