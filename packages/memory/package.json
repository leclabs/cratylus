{
  "name": "@cratylus/memory",
  "version": "0.0.0",
  "//": "FORK-3 (publish) unresolved: kept private:true. Drop the flag when the publish story lands — the bin-drop + strategy impl do not block on it.",
  "description": "The memory runtime-capability plugin: a MemoryStrategy over an EPISODIC store plus the CoALA consolidation verbs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./seedTemplates": {
      "types": "./dist/seeds.d.ts",
      "import": "./dist/seeds.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@cratylus/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "latent-lexicography",
    "cratylus",
    "memory",
    "agent",
    "coala",
    "capability",
    "plugin"
  ],
  "author": "Lance Caraccioli <lance.caraccioli@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leclabs/cratylus.git",
    "directory": "packages/memory"
  },
  "bugs": {
    "url": "https://github.com/leclabs/cratylus/issues"
  },
  "homepage": "https://github.com/leclabs/cratylus#readme"
}
