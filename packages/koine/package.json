{
  "name": "@leclabs/koine",
  "version": "0.0.0",
  "description": "koine — universal agent configuration translator: canonical IR, official adapters, and CLI in one package",
  "license": "MIT",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "koine": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./anatomy": {
      "types": "./dist/anatomy/index.d.ts",
      "import": "./dist/anatomy/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*/index.d.ts",
      "import": "./dist/adapters/*/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "gen": "tsx src/core/scripts/generate-types.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist src/core/ir/generated.ts"
  },
  "dependencies": {
    "@iarna/toml": "catalog:",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "cac": "catalog:",
    "chokidar": "catalog:",
    "gray-matter": "catalog:",
    "js-yaml": "catalog:",
    "picocolors": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "json-schema-to-typescript": "^15.0.0",
    "tsup": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
