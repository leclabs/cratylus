{
  "name": "@cratylus/forge",
  "version": "0.1.0",
  "description": "The deterministic projection from canonical meaning onto one harness’s surfaces — resolve, project, validate and deploy a corpus. Owns the mapping and nothing else.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "cratylus": "./dist/cli/index.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./module-scan": {
      "types": "./dist/core/module-scan.d.ts",
      "import": "./dist/core/module-scan.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./resolve": {
      "types": "./dist/resolve/index.d.ts",
      "import": "./dist/resolve/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js"
    },
    "./validate": {
      "types": "./dist/validate/index.d.ts",
      "import": "./dist/validate/index.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*/index.d.ts",
      "import": "./dist/adapters/*/index.js"
    },
    "./project": {
      "types": "./dist/project/index.d.ts",
      "import": "./dist/project/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@cratylus/runtime": "workspace:*",
    "@cratylus/schema": "workspace:*",
    "@iarna/toml": "catalog:",
    "cac": "catalog:",
    "picocolors": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/tooling": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "latent-lexicography",
    "cratylus",
    "projection",
    "codegen",
    "agent",
    "skill",
    "harness",
    "cli"
  ],
  "author": "Lance Caraccioli <lance.caraccioli@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leclabs/cratylus.git",
    "directory": "packages/forge"
  },
  "bugs": {
    "url": "https://github.com/leclabs/cratylus/issues"
  },
  "homepage": "https://github.com/leclabs/cratylus#readme"
}
