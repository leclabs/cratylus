{
  "name": "@cratylus/schema",
  "version": "0.12.0",
  "description": "The shapes the canon is written against: its factors, their values, terms and corrections, hook declarations and plugin, as a TypeScript type system, so a value given to the wrong factor fails to compile.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hook": {
      "types": "./dist/hook/index.d.ts",
      "import": "./dist/hook/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cratylic-context-design",
    "cratylus",
    "schema",
    "types",
    "meta-model",
    "agent",
    "factor"
  ],
  "author": "Lance Caraccioli <lance.caraccioli@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leclabs/cratylus.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/leclabs/cratylus/issues"
  },
  "homepage": "https://github.com/leclabs/cratylus#readme"
}
