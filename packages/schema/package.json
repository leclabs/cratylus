{
  "name": "@cratylus/schema",
  "version": "0.0.0",
  "description": "schema — the shapes a corpus authors against: MODEL.md realized in types. Canon authors against it, forge projects against it, and it holds no opinion about either.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hook": {
      "types": "./dist/hook/index.d.ts",
      "import": "./dist/hook/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "gen": "tsx src/hook/generate.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@cratylus/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "json-schema-to-typescript": "^15.0.0",
    "tsup": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
