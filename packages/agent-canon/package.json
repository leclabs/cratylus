{
  "name": "@leclabs/agent-canon",
  "version": "0.0.0",
  "description": "agent-canon \u2014 the culture corpus as typed TS source (T1.1 spike scaffold). Markdown is a projection of these modules.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "project": "tsx src/toolkit/project-cli.ts",
    "project:codex": "tsx src/toolkit/project-cli-codex.ts",
    "project:targets": "tsx src/toolkit/project-targets-cli.ts",
    "plan-set": "tsx src/toolkit/plan-set-cli.ts",
    "scaffold": "tsx src/toolkit/scaffold-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@leclabs/agent-forge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
