{
  "name": "@leclabs/agent-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "@leclabs/agent-runtime \u2014 the per-host RUNTIME contract leaf: capability port interfaces (MemoryStrategy, EventTapHost), the RuntimePlugin face, and the runtime-owned lifecycle-event taxonomy. Pure types + identity helper, zero @leclabs deps.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./dispatch": {
      "types": "./dist/dispatch.d.ts",
      "import": "./dist/dispatch.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./ports/memory": {
      "types": "./dist/ports/memory.d.ts",
      "import": "./dist/ports/memory.js"
    },
    "./ports/event-tap": {
      "types": "./dist/ports/event-tap.d.ts",
      "import": "./dist/ports/event-tap.js"
    },
    "./capabilities/event-tap": {
      "types": "./dist/capabilities/event-tap.d.ts",
      "import": "./dist/capabilities/event-tap.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "cac": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
