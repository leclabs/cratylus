{
  "name": "@leclabs/polis",
  "version": "0.0.0",
  "private": true,
  "description": "polis — the canonical culture (mind) and projection machinery (koine) from which agent societies are founded.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "mind:project": "pnpm --filter @leclabs/mind project",
    "mind:deploy:agent": "node packages/koine/dist/cli/index.js deploy --kind agent --agents-dir packages/mind/.render-ts/agents --skills-dir packages/mind/.render-ts/skills",
    "mind:deploy:skill": "node packages/koine/dist/cli/index.js deploy --kind skill --agents-dir packages/mind/.render-ts/agents --skills-dir packages/mind/.render-ts/skills",
    "mind:deploy:hooks": "node packages/koine/dist/cli/index.js deploy --kind hooks --hooks-dir packages/mind/.render-ts",
    "mind:deploy": "pnpm build && pnpm mind:project && pnpm mind:deploy:agent && pnpm mind:deploy:skill && pnpm mind:deploy:hooks",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky",
    "continuity:install": "sh packages/mind/src/toolkit/continuity/continuity-hook.sh install",
    "continuity:uninstall": "sh packages/mind/src/toolkit/continuity/continuity-hook.sh uninstall",
    "continuity:status": "sh packages/mind/src/toolkit/continuity/continuity-hook.sh status",
    "stance-guard:on": "git config --bool polis.stanceGuard true",
    "stance-guard:off": "git config --unset polis.stanceGuard",
    "stance-guard:status": "git config --bool polis.stanceGuard || echo 'disabled (default)'",
    "stance-guard:test": "sh packages/mind/src/toolkit/guardrail/test-stance-guardrail.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "prettier": "3",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
