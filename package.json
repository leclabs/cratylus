{
  "name": "cratylus",
  "version": "0.0.0",
  "private": true,
  "description": "cratylus — latent lexicography: the canon of discovered semantic addresses (canon) and the projection machinery (forge) that compiles them into runtime artifacts.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "typecheck:test": "turbo run typecheck:test",
    "canon:project": "pnpm build && agent-forge project --harness claude --out packages/canon/.render-ts",
    "canon:project:codex": "pnpm build && agent-forge project --harness codex --out packages/canon/.render-ts-codex",
    "canon:project:targets": "pnpm --filter @cratylus/canon project:targets",
    "canon:deploy:agent": "agent-forge deploy --kind agent --agents-dir packages/canon/.render-ts/agents --skills-dir packages/canon/.render-ts/skills",
    "canon:deploy:skill": "agent-forge deploy --kind skill --agents-dir packages/canon/.render-ts/agents --skills-dir packages/canon/.render-ts/skills",
    "canon:deploy:hooks": "agent-forge deploy --kind hooks --hooks-dir packages/canon/.render-ts",
    "canon:deploy": "pnpm canon:project && agent-forge deploy --agents-dir packages/canon/.render-ts/agents --skills-dir packages/canon/.render-ts/skills --hooks-dir packages/canon/.render-ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky",
    "continuity:install": "sh packages/canon/src/toolkit/continuity/continuity-hook.sh install",
    "continuity:uninstall": "sh packages/canon/src/toolkit/continuity/continuity-hook.sh uninstall",
    "continuity:status": "sh packages/canon/src/toolkit/continuity/continuity-hook.sh status",
    "stance-guard:on": "git config --bool agentfactory.stanceGuard true",
    "stance-guard:off": "git config --unset agentfactory.stanceGuard",
    "stance-guard:status": "git config --bool agentfactory.stanceGuard || echo 'disabled (default)'",
    "stance-guard:test": "sh packages/canon/src/toolkit/guardrail/test-stance-guardrail.sh",
    "dev": "turbo run dev --parallel",
    "praxis": "sh packages/canon/src/toolkit/praxis/praxis.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cratylus/canon": "workspace:*",
    "@cratylus/forge": "workspace:*",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "prettier": "3",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
