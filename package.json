{
  "name": "@cratylus/workspace",
  "version": "0.0.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "error"
    }
  },
  "description": "This repository's workspace root. PRIVATE and unpublished by construction — the `@repo` scope is not `@cratylus`, so it cannot be published by accident, and it no longer collides with the `cratylus` package that ships the command.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "typecheck:test": "turbo run typecheck:test",
    "canon:project": "pnpm canon:project:omp",
    "canon:project:omp": "pnpm build && pnpm exec cratylus project --harness omp --out .cratylus/omp",
    "canon:project:targets": "pnpm --filter @cratylus/canon project:targets",
    "canon:deploy:agent": "pnpm exec cratylus deploy --kind agent",
    "canon:deploy:skill": "pnpm exec cratylus deploy --kind skill",
    "canon:deploy:hooks": "pnpm exec cratylus deploy --kind hooks",
    "canon:deploy": "pnpm canon:project && pnpm exec cratylus deploy",
    "changeset": "changeset",
    "version-packages": "changeset version && biome check --write . && prettier --write \"**/CHANGELOG.md\"",
    "release": "sh scripts/release.sh",
    "prepare": "husky",
    "dev": "turbo run dev --parallel",
    "project": "pnpm canon:project:omp",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cratylus/canon": "workspace:*",
    "cratylus": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  }
}
