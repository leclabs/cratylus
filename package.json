{
  "name": "@repo/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "This repository's workspace root. PRIVATE and unpublished by construction \u2014 the `@repo` scope is not `@cratylus`, so it cannot be published by accident, and it no longer collides with the `cratylus` package that ships the command.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "typecheck:test": "turbo run typecheck:test",
    "canon:project": "pnpm build && pnpm exec cratylus project --harness claude --out .cratylus/claude",
    "canon:project:codex": "pnpm build && pnpm exec cratylus project --harness codex --out .cratylus/codex",
    "canon:project:targets": "pnpm --filter @cratylus/canon project:targets",
    "canon:deploy:agent": "pnpm exec cratylus deploy --kind agent",
    "canon:deploy:skill": "pnpm exec cratylus deploy --kind skill",
    "canon:deploy:hooks": "pnpm exec cratylus deploy --kind hooks",
    "canon:deploy": "pnpm canon:project && pnpm exec cratylus deploy",
    "changeset": "changeset",
    "version-packages": "changeset version && biome check --write . && prettier --write \"**/CHANGELOG.md\"",
    "release": "sh scripts/release.sh",
    "prepare": "husky",
    "continuity:install": "pnpm --filter @cratylus/canon run continuity install",
    "continuity:uninstall": "pnpm --filter @cratylus/canon run continuity uninstall",
    "continuity:status": "pnpm --filter @cratylus/canon run continuity status",
    "stance-guard:on": "git config --bool agentfactory.stanceGuard true",
    "stance-guard:off": "git config --unset agentfactory.stanceGuard",
    "stance-guard:status": "git config --bool agentfactory.stanceGuard || echo 'disabled (default)'",
    "stance-guard:test": "pnpm --filter @cratylus/canon run stance-guard:test",
    "dev": "turbo run dev --parallel",
    "praxis": "pnpm --filter @cratylus/canon run praxis",
    "oracle": "pnpm --filter @cratylus/canon run oracle",
    "oracle:update": "pnpm --filter @cratylus/canon run oracle:update",
    "verify": "pnpm build && pnpm lint && pnpm oracle && pnpm test",
    "pack:smoke": "pnpm --filter @cratylus/canon pack:smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@cratylus/canon": "workspace:*",
    "cratylus": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "3",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
