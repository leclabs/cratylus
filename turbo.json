{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "typecheck:test": {
      "dependsOn": ["^build"]
    },
    // test — NOT CACHED, deliberately.
    //
    // Six canon gates scan by `git ls-files` from the repo ROOT: architecture,
    // command-veracity, hook-rule-boundary, plan-set, bin-name-single-home and
    // gate-convicts reach plans/, AGENTS.md, the root ground docs, and other
    // packages' manifests. Turbo's cache key is a package's own inputs plus its
    // dependencies' outputs — provably NARROWER than that scan domain. A commit
    // touching only the scanned corpus produces a HIT and REPLAYS the previous
    // green log without running the gate, so cached-green becomes
    // indistinguishable from actually-green. That is precisely the defect
    // `gate-convicts.test.ts` exists to forbid one level down.
    //
    // Declaring the true `inputs` is the alternative and it is worse: the honest
    // input set here is "everything git tracks", which is a cache that never hits
    // wearing the costume of one that does.
    //
    // The suite is ~11s. Correctness is worth 11 seconds in a repository whose
    // entire thesis is verification.
    // `typecheck:test` is a DEPENDENCY of `test`, not a sibling task.
    //
    // It went red on a clean tree and stayed red, because `pnpm test` ran a
    // 9-task pipeline that did not include it: the repository's green suite and
    // its red type-check were two different commands, and only one was in
    // anyone's habit. That is worse than an absent check — it is an UNWATCHED
    // one, and the tests are the enforcement layer for every naming and shape
    // guarantee this project makes. An unchecked test tree is an unchecked
    // enforcement layer.
    //
    // Declaring it here rather than in a release script is deliberate: a gate
    // that only the release runs is a gate that fails at the worst moment.
    "test": {
      "dependsOn": ["^build", "typecheck:test"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
